# WindWise — deployment configuration for Vercel
# See: https://vercel.com/docs/projects/project-configuration

{
  "version": 2,
  "name": "windwise",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "ENV_BACKEND_URL/api/:path*" }
  ],
  "env": {
    "VITE_API_URL": "@windwise-api-url"
  }
}
