# WindWise Backend Environment Variables
# Copy this file to .env and fill in real values — never commit .env

# Elexon BMRS API base URL (no trailing slash)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Day-ahead market purchasing decision cutoff (24-hour format, UTC)
# EPEX SPOT GB day-ahead gate closure: 09:20 UTC
# Rationale: EPEX SPOT operates the GB day-ahead auction with gate closure at 09:20 GMT.
# All procurement decisions for delivery date D must be submitted by 09:20 on day D-1.
# Therefore eligible forecasts are those with publishTime <= D-1 09:20:00 UTC.
FORECAST_CUTOFF_HOUR=9
FORECAST_CUTOFF_MINUTE=20

# Request timeout in seconds
API_TIMEOUT=60

# Cache duration in seconds (default: 1 hour)
CACHE_TTL=3600

# Allowed CORS origins (comma-separated, no trailing slashes)
# For local dev: http://localhost:5173
# For production: https://your-vercel-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment label (development | production)
ENVIRONMENT=development
